{
  "info": {
    "_postman_id": "b74fc3d8-c284-47f8-b113-4852f99a8ea0",
    "name": "SIMBBiz Password Recovery",
    "description": "Test the password-recovery API. Set accountEmail and recoveryEmail, validate the account to receive a recoveryToken, request an OTP through either channel, set otp to the delivered code, verify it, then reset the password. WhatsApp free-form delivery requires an open 24-hour customer-service window.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api" },
    { "key": "accountEmail", "value": "local-account@example.com" },
    { "key": "recoveryEmail", "value": "recovery@example.com" },
    { "key": "recoveryToken", "value": "" },
    { "key": "otp", "value": "00000000" },
    { "key": "resetToken", "value": "" },
    { "key": "newPassword", "value": "ReplaceWithNewPassword123!" }
  ],
  "item": [
    {
      "name": "1. Validate account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.recoveryToken) pm.collectionVariables.set('recoveryToken', body.recoveryToken);",
              "  if (body.email) pm.collectionVariables.set('accountEmail', body.email);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"recoveryEmail\": \"{{recoveryEmail}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/forget-password"
      }
    },
    {
      "name": "2a. Send OTP by email",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recoveryToken\": \"{{recoveryToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/forget-password/email"
      }
    },
    {
      "name": "2b. Create WhatsApp handoff (send from registered number)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recoveryToken\": \"{{recoveryToken}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/forget-password/whatsapp"
      }
    },
    {
      "name": "3. Verify OTP",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const body = pm.response.json();",
              "  if (body.resetToken) pm.collectionVariables.set('resetToken', body.resetToken);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"recoveryToken\": \"{{recoveryToken}}\",\n  \"otp\": \"{{otp}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/forget-password/verify-otp"
      }
    },
    {
      "name": "4. Reset password",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{accountEmail}}\",\n  \"resetToken\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/reset-password"
      }
    }
  ]
}
