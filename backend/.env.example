PORT=4000
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
MONGODB_URI=your_mongodb_uri_here
FIREBASE_API_KEY=your_firebase_api_key_here
REDIS_URI=your_redis_uri_here

META_ACCESS_TOKEN=your_meta_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id_here
META_GRAPH_API_VERSION=v20.0

WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here
META_APP_SECRET=your_meta_app_secret_here

OTP_TEMPLATE_NAME=your_approved_otp_template_name

EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_google_app_password_here
OTP_DEBUG_LOGGING=false

WHATSAPP_OTP_MESSAGE_TEMPLATE="SIMBBiz password reset code: {{otp}}. It expires in {{expiresMinutes}} minutes. Do not share this code."

FAPSHI_API_USER=your_fapshi_api_user_here
FAPSHI_API_SECRET=your_fapshi_api_secret_here
FAPSHI_WEBHOOK_SECRET=your_fapshi_webhook_secret_here
# Use the live Fapshi base URL with live credentials in production.
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FRONTEND_URL=https://simbbiz.com
